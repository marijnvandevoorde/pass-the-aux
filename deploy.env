# sv-deploy config: ships origin/main to the cluster sv-oke.
# See ../../Oracle/deploy/README.md. Run: npm run deploy (or scripts/deploy.sh --check).
APP=pass-the-aux
# name|build context|Dockerfile|extra buildx args ({SHA}: the commit, shown in the footer)
IMAGES='
pass-the-aux|.|Dockerfile|--build-arg APP_VERSION={SHA}
'
TARGETS="apps/pass-the-aux/pass-the-aux=pass-the-aux"
# The DJ app redirects to /login without a session (302).
SMOKE_URLS="https://passtheaux.small-victories.co/"
MANIFESTS="k8s/apps/tier2/stacks.py"
