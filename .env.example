# Copy to .env and adjust. All values are optional — these are the defaults.
# .env is gitignored; put any future secrets (e.g. a music-source API key)
# here, never in source.

# Network
HOST=0.0.0.0          # 127.0.0.1 to restrict to this machine only
PORT=5174

# Library
MUSIC_DIR=./music     # absolute path recommended in production

# Limits
# BODY_LIMIT_BYTES=1000000  # max JSON body per request (default ~1 MB, DoS shield)

# Remote record stores are managed per-user via Settings → Remote
# record stores (URL + Bearer secret). The canonical server is
# pass-the-remote (https://github.com/marijnvandevoorde/pass-the-remote),
# but anything speaking the Pass the Aux wire contract works.

# Public base URL for the crowd-join QR/link. Default = the app
# itself; set to your LAN IP or tunnel so phones can reach it, e.g.
# http://192.168.1.20:5174
PUBLIC_BASE_URL=http://localhost:5174

# ── Storage ──────────────────────────────────────────────────────
# Persistence backend. Exactly one, no fallback.
#   sqlite = single SQLite file via node:sqlite (zero-dep, default)
#   mysql  = MySQL via the mysql2 driver (see docker-compose.mysql.yml)
STORAGE_DRIVER=sqlite

# SQLite file (only read when STORAGE_DRIVER=sqlite). Defaults to
# .pass-the-aux.sqlite inside MUSIC_DIR.
# SQLITE_PATH=/var/lib/pass-the-aux/db.sqlite

# MySQL connection (only read when STORAGE_DRIVER=mysql).
# The docker-compose.mysql.yml dev container also reads these.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=passtheaux
DB_USER=passtheaux
DB_PASSWORD=change-me-strong-password
# Container only: root password + the host port the dev DB is exposed on.
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
DB_HOST_PORT=3307

# ── Auth / sessions ──────────────────────────────────────────────
# Long random string: signs session cookies + encrypts TOTP secrets.
# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# Self-service account creation. OFF by default: the register
# endpoint returns 403 and the login page hides the "create account"
# link. Set to 1/true/on/yes to open public registration.
REGISTRATION_OPEN=off

# ── Audio analysis engine ────────────────────────────────────────
# Which engine enriches `analysis` + builds beat grids:
#   local         = in-house ffmpeg + Ellis-DP DSP (zero-dep, default).
#                   Good enough for tracks with a clear beat.
#   pass-the-beat = the self-hosted pass-the-beat sidecar
#                   (https://github.com/marijnvandevoorde/pass-the-beat),
#                   which wraps the beat-this model. Far more accurate
#                   beat-grids → solid sync and noticeably better
#                   DJ'ing. Needs the pass-the-beat container running on
#                   the shared `pta` docker network (see README → Docker
#                   → Running with companions).
BEAT_ANALYZER=local
# Base URL of the pass-the-beat sidecar (only read when
# BEAT_ANALYZER=pass-the-beat). Defaults to the container name on the
# `pta` docker network.
PASS_THE_BEAT_URL=http://pass-the-beat:8000

